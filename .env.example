# Public, non-secret client configuration only.
# Anything secret belongs on the server, never in a VITE_* variable:
# Vite inlines these into the shipped bundle.

# Absolute origin the app is served from (used later for share/booking links).
VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------- data plane
# Supabase, wired in Prompt #02. Both values below are PUBLISHABLE by design: the
# anon key identifies this app to PostgREST, and row-level security (migration 003)
# is what limits what a request can reach — an unauthenticated request sees no rows
# and every write door refuses with NIVAAS_NO_SESSION.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY, a database password, or an SMTP token in a
# VITE_* variable. A service-role key in a browser bundle hands the entire
# multi-tenant database to anyone who opens devtools, and this repository is public.
#
# Create a NEW AMRUT NIVAAS Supabase project for this product. Pointing these at the
# donor poultry app's project would run a foreign schema against a live tenant
# database — that mistake is not recoverable by undoing a migration.
#
# Without these two variables the app still boots and says which one is missing.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
